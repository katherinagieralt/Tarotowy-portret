# Docker Environment Configuration for Tarotowy Portret
# Copy this file to .env and adjust values as needed

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL credentials
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tarot_db

# Prisma Database URL (for local development WITHOUT Docker, comment this out)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tarot_db

# Prisma Database URL (for Docker - automatically set by docker-compose.yml)
# Inside Docker: postgres service is accessible as "postgres:5432" on the internal network
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/tarot_db

# ============================================================================
# NEXT.JS / APPLICATION CONFIGURATION
# ============================================================================

# Node environment
NODE_ENV=development

# Next.js app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Log level for npm
NPM_LOG_LEVEL=warn

# ============================================================================
# AUTHENTICATION (NextAuth)
# ============================================================================

# NextAuth secret - MUST be changed in production!
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-change-in-production-12345678901234567890

# NextAuth URL - where your app is hosted
NEXTAUTH_URL=http://localhost:3000

# ============================================================================
# EXTERNAL SERVICES (Optional)
# ============================================================================

# Email service (Resend)
# RESEND_API_KEY=your-resend-api-key

# Cloud storage (UploadThing)
# UPLOADTHING_SECRET=your-uploadthing-secret
# UPLOADTHING_APP_ID=your-uploadthing-app-id

# Cloudflare Turnstile (bot protection)
# NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=your-site-key

# ============================================================================
# ADMIN CONFIGURATION
# ============================================================================

# Admin email address
ADMIN_EMAIL=admin@tarot.pl

# ============================================================================
# PRISMA CONFIGURATION
# ============================================================================

# Engine type (binary is fastest for development)
PRISMA_CLI_QUERY_ENGINE_TYPE=binary

# Skip Prisma generation errors in CI/CD
# PRISMA_SKIP_ENGINE_CHECK=true

# ============================================================================
# DEVELOPMENT NOTES
# ============================================================================

# When running with Docker:
# 1. Uncomment DATABASE_URL line pointing to Docker PostgreSQL service
# 2. Change NEXTAUTH_SECRET to a random value
# 3. Adjust other values as needed for your environment

# For Docker Compose:
# - Database service name: postgres
# - Database port (internal): 5432
# - Database port (external): 5432
# - NextJS port: 3000
# - Adminer (DB UI): 8080
